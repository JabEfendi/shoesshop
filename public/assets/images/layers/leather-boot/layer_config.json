      "options": {
        "hw-nikel-silver":     { "file": "hw-nikel-silver.png",     "hex": "#c0c0c0", "label": "Eyelet Nikel Silver", "roughness": 0.30, "metalness": 0.85 },
        "hw-gold-brass":       { "file": "hw-gold-brass.png",       "hex": "#b8860b", "label": "Eyelet Kuning Brass", "roughness": 0.35, "metalness": 0.75 },
        "hw-black-pvd":        { "file": "hw-black-pvd.png",        "hex": "#2a2a2a", "label": "Eyelet Black PVD",   "roughness": 0.55, "metalness": 0.60 },
        "hw-antik-perak":      { "file": "hw-antik-perak.png",      "hex": "#7a7a7a", "label": "Eyelet Perak Antik", "roughness": 0.60, "metalness": 0.65 }
      }
    },
    {
      "z_index": 60,
      "category": "stitching",
      "layer_key": "060_stitching",
      "folder": "angles/front-3q/060_stitching",
      "fallback_shape": "stitch_lines",
      "defaults_to": "stitch-match",
      "opacity": 0.88,
      "blend_mode": "normal",
      "options": {
        "stitch-match":        { "file": "stitch-match.png",        "hex": null,      "label": "Benang Match (Sama Kulit)" },
        "stitch-contrast-tan": { "file": "stitch-contrast-tan.png", "hex": "#b38247", "label": "Benang Kontras Tan" },
        "stitch-putih":        { "file": "stitch-putih.png",        "hex": "#ffffff", "label": "Benang Jahit Putih" },
        "stitch-hitam":        { "file": "stitch-hitam.png",        "hex": "#1a1a1a", "label": "Benang Jahit Hitam" }
