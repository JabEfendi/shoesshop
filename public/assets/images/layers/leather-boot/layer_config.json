      "defaults_to": "kulit-coklat-tua",
      "opacity": 1.0,
      "blend_mode": "multiply_if_photo_base",
      "options": {
        "kulit-coklat-tua":    { "file": "kulit-coklat-tua.png",    "hex": "#4a2c1a", "label": "Kulit Coklat Tua",   "roughness": 0.85, "metalness": 0.05 },
        "kulit-coklat-muda":   { "file": "kulit-coklat-muda.png",   "hex": "#8b5a2b", "label": "Kulit Coklat Muda",  "roughness": 0.80, "metalness": 0.05 },
        "kulit-hitam-full":    { "file": "kulit-hitam-full.png",    "hex": "#1a1a1a", "label": "Kulit Hitam Full",   "roughness": 0.75, "metalness": 0.10 },
        "kulit-oak-burgundy":  { "file": "kulit-oak-burgundy.png",  "hex": "#5e1f1f", "label": "Kulit Burgundy Oak", "roughness": 0.80, "metalness": 0.05 },
        "kulit-suede-taupe":   { "file": "kulit-suede-taupe.png",   "hex": "#8e8376", "label": "Suede Taupe Matte",  "roughness": 1.00, "metalness": 0.00 }
      }
    },
    {
      "z_index": 40,
      "category": "laces",
      "layer_key": "040_laces",
      "folder": "angles/front-3q/040_laces",
