{
  "_meta": {
    "model_slug": "leather-boot",
    "view_angle": "front-3q",
    "canvas_size": { "width": 800, "height": 600 },
    "base_photo": "/assets/images/products/boots/front-side.jpeg",
    "use_photo_as_bg": true,
    "layer_mode": "overlay_2d"
  },
  "layers": [
    {
      "z_index": 10,
      "category": "sole",
      "layer_key": "010_sole",
      "folder": "angles/front-3q/010_sole",
      "fallback_shape": "sole",
      "defaults_to": "sole-karet-hitam",
      "opacity": 1.0,
      "blend_mode": "normal",
      "options": {
        "sole-karet-hitam":    { "file": "sole-karet-hitam.png",    "hex": "#1a1a1a", "label": "Sol Karet Hitam" },
        "sole-kulit-coklat":   { "file": "sole-kulit-coklat.png",   "hex": "#6b3a0d", "label": "Sol Kulit Coklat" },
        "sole-crepe-beige":    { "file": "sole-crepe-beige.png",    "hex": "#d8c49a", "label": "Sol Crepe Beige" },
        "sole-commando":       { "file": "sole-commando.png",       "hex": "#2a2a2a", "label": "Sol Commando Lug" }
      }
    },
    {
      "z_index": 20,
      "category": "insole",
      "layer_key": "020_insole",
      "folder": "angles/front-3q/020_insole",
      "fallback_shape": "insole",
      "defaults_to": "insole-eva-standar",
      "opacity": 0.95,
      "blend_mode": "normal",
