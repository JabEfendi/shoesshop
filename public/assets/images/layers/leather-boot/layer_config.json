        "laces-waxed-coklat":  { "file": "laces-waxed-coklat.png",  "hex": "#4a2c1a", "label": "Tali Waxed Coklat" },
        "laces-flat-hitam":    { "file": "laces-flat-hitam.png",    "hex": "#1a1a1a", "label": "Tali Flat Hitam" },
        "laces-bulat-tan":     { "file": "laces-bulat-tan.png",     "hex": "#b38247", "label": "Tali Bulat Tan" },
        "laces-paracord-od":   { "file": "laces-paracord-od.png",   "hex": "#556b2f", "label": "Tali Paracord OD" }
      }
    },
    {
      "z_index": 50,
      "category": "hardware",
      "layer_key": "050_hardware",
      "folder": "angles/front-3q/050_hardware",
      "fallback_shape": "eyelets",
      "defaults_to": "hw-nikel-silver",
      "opacity": 1.0,
